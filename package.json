{
  "name": "trendboda",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev -w @trendboda/web",
    "build:web": "npm run build -w @trendboda/web",
    "db:generate": "npm run db:generate -w @trendboda/backend",
    "design:tokens": "npm run design:tokens -w @trendboda/web",
    "design:lint": "npm run design:lint -w @trendboda/web",
    "test:db": "docker compose -f compose.yml -f compose.local.yml run --rm --build test",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "check:floor": "node scripts/floor-guard.mjs --base \"${CHECK_BASE:-origin/main}\"",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present && node scripts/merge-coverage.mjs",
    "check:coverage": "node scripts/wf-artifacts/diff-coverage.mjs coverage/lcov.info --base \"${CHECK_BASE:-origin/main}\" --min 80",
    "check:fast": "npm run typecheck && npm run lint",
    "check:task": "npm run check:fast && npm run check:secrets && npm run check:floor && npm run test:guards && npm run test:coverage && npm run check:coverage",
    "check:full": "npm run check:task && npm run test:db",
    "test:guards": "node --test scripts/floor-guard.test.mjs"
  }
}
