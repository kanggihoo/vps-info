{
  "name": "signal-archive",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev -w @signal-archive/web",
    "build:web": "npm run build -w @signal-archive/web",
    "db:generate": "npm run db:generate -w @signal-archive/backend",
    "design:tokens": "npm run design:tokens -w @signal-archive/web",
    "design:lint": "npm run design:lint -w @signal-archive/web",
    "ui:add": "npm run ui:add -w @signal-archive/web --",
    "test:db": "docker compose -f compose.yml -f compose.local.yml run --rm --build test"
  }
}
