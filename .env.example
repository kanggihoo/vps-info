POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=signal_archive
POSTGRES_USER=signal_archive
POSTGRES_PASSWORD=replace-me

# 로컬에서 앱을 여는 호스트 포트(compose.local.yml)
APP_PORT=8000

# DeepL API 키(ADR-0011). Entry 펼친 화면의 번역 버튼이 쓴다. 비워 두면 번역만 빠지고 나머지는 동작한다.
# 무료 키는 `:fx`로 끝나며 api-free.deepl.com으로 보낸다. https://www.deepl.com/your-account/keys
DEEPL_API_KEY=

# Product Hunt API(GraphQL). Ranked Feed가 쓴다. 비상업 용도만 허용된다.
# https://www.producthunt.com/v2/oauth/applications 에서 Confidential 앱을 등록해 받는다.
PRODUCT_HUNT_CLIENT_ID=
PRODUCT_HUNT_CLIENT_SECRET=

# Entry 대화(ADR-0018). 비워 둔 엔진만 빠지고 나머지는 동작한다.
# Claude·OpenAI는 키가 아니라 llm_auth 볼륨의 auth.json(구독 로그인)으로 인증한다(README의 "Entry 대화 인증").
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
